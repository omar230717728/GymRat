rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- USER DATA ---
    // Allow users to read/write their own data (Profile, Stats, Favorites)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections (stats, favorites) inherit access if explicitly defined or via wildcard
      match /stats/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /favorites/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // --- PROGRESS TRACKING (CRITICAL FIX) ---
    // Allow any authenticated user to CREATE a progress log.
    // Allow users to READ only their own logs.
    match /progress/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // --- PUBLIC DATA (Read Only) ---
    match /exercises/{document=**} { allow read: if true; }
    match /machines/{document=**} { allow read: if true; }
    match /muscles/{document=**} { allow read: if true; }
    match /body_parts/{document=**} { allow read: if true; }
  }
}
